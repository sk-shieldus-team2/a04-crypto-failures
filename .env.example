# 복사해서 쓰기: cp .env.example .env  후 각 값을 채운다.
# 배포(EC2)에서는 이 값들을 AWS Parameter Store(SecureString)에서 주입한다.

# Oracle SYS/SYSTEM 관리자 비밀번호
ORACLE_PASSWORD=change_me

# 앱용 DB 계정 (Oracle 생성 + WebLogic 데이터소스 공용)
APP_USER=team2
APP_USER_PASSWORD=change_me

# WebLogic 관리자 계정
WLS_USERNAME=team2
WLS_PASSWORD=change_me
